# ── Server ──
SERVER_DOMAIN=
LETSENCRYPT_EMAIL=

# ── PostgreSQL — ClanService ──
CLAN_DB_USER=postgres
CLAN_DB_PASSWORD=
CLAN_DB_NAME=clanservicedb

# ── PostgreSQL — IdentityService ──
IDENTITY_DB_USER=admin
IDENTITY_DB_PASSWORD=
IDENTITY_DB_NAME=IdentityDb

# ── PostgreSQL — NotificationService ──
NOTIFICATION_DB_USER=admin
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_NAME=NotificationDb

# ── MongoDB — MessageService ──
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=


AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth_db
# ── JWT (shared across services) ──
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# ── RabbitMQ (CloudAMQP) ──
RABBITMQ_HOST=
RABBITMQ_VHOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=UserUpdatedQueue

# ── CORS ──
CORS_ORIGIN_1=
CORS_ORIGIN_2=

# ── LiveKit ──
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=0.0.0.0

# ── SMTP (IdentityService) ──
SMTP_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_FROM_NAME=Sesver
SMTP_FROM_ADDRESS=from@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_CONFIRMATION_URL=http://localhost:5173/confirm-email
